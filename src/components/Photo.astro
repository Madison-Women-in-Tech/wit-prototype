---
// Photo from the existing site. `alt` is REQUIRED and positional-first in the
// props so it can't quietly be forgotten — an accessibility-minded org
// shouldn't ship decorative-only images of its own members.
//
// Photos already live in public/images/photos/. Missing/renamed files render
// as a labelled placeholder rather than a broken icon.
const {
  src,
  alt,
  ratio = '3 / 2',
  caption,
  eager = false,
} = Astro.props;

if (!alt) throw new Error(`<Photo src="${src}"> is missing required alt text.`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/images/photos/${src}`;
---
<figure class="photo" style={`--ratio:${ratio}`}>
  <div class="ph-frame">
    <img
      src={href}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      onerror="this.closest('.ph-frame').classList.add('missing')"
    />
    <span class="ph-fallback" aria-hidden="true">{src}</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; }
  .ph-frame {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-alt);
  }
  .ph-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .ph-fallback {
    display: none;
    position: absolute; inset: 0;
    align-items: center; justify-content: center;
    font-size: .75rem; color: var(--ink-soft);
    font-family: var(--font-body); font-style: italic;
    text-align: center; padding: 1rem;
  }
  .ph-frame.missing img { display: none; }
  .ph-frame.missing .ph-fallback { display: flex; }
  .ph-frame.missing::after {
    content: '';
    position: absolute; inset: 0;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
  }
  figcaption {
    font-size: .78rem; color: var(--ink-soft);
    margin-top: .5rem; line-height: 1.45;
  }
</style>
