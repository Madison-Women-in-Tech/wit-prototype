---
import site from '../data/site.json';
import NewsletterForm from './NewsletterForm.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <img
        src={`${base}/images/logo-reversed.png`}
        alt="Madison Women in Tech"
        width="72" height="72" class="foot-mark" />
      <h3>Our mission</h3>
      <p class="mission">{site.mission}</p>
      <p class="social">
        <a href={site.social.facebook} rel="noopener">Facebook</a>
        <a href={site.social.instagram} rel="noopener">Instagram</a>
        <a href={site.social.linkedin} rel="noopener">LinkedIn</a>
      </p>
      <p class="xnote">
        Prototype note: X/Twitter dropped from the footer pending a decision on
        whether that account is still active.
      </p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        <li><a href={`${base}/about`}>About</a></li>
        <li><a href={`${base}/join`}>Join</a></li>
        <li><a href={`${base}/job-fair`}>Job Fair</a></li>
        <li><a href={site.meetupEvents} rel="noopener">Events</a></li>
        <li><a href={`mailto:${site.email}`}>Contact us</a></li>
        <li><a href={site.donate} rel="noopener">Donate</a></li>
      </ul>
    </div>

    <div class="foot-sub">
      <NewsletterForm compact={true} />
    </div>
  </div>

  <div class="wrap foot-base">
    <p>&copy; {year} {site.name} &middot; Volunteer-run &middot; Membership is 100% free</p>
  </div>
</footer>

<style>
  .site-foot { background: var(--brand-deep); color: #fff; padding-top: 3.5rem; margin-top: 2rem; }
  .foot-mark { width: 72px; height: 72px; margin-bottom: 1.1rem; }
  .site-foot h3 { color: #fff; font-size: .8rem; text-transform: uppercase; letter-spacing: .12em; }
  .foot-grid { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .mission { color: rgba(255,255,255,.78); font-size: .9rem; max-width: 42ch; }
  .site-foot ul { list-style: none; margin: 0; padding: 0; }
  .site-foot li { margin-bottom: .45rem; }
  .site-foot a { color: rgba(255,255,255,.88); text-decoration: none; font-size: .92rem; }
  .site-foot a:hover { color: #fff; text-decoration: underline; }
  .social { display: flex; gap: 1rem; margin-top: 1rem; }
  .xnote { font-size: .72rem; color: rgba(255,255,255,.45); font-style: italic; max-width: 38ch; }
  .foot-sub :global(h3) { color: #fff; }
  .foot-sub :global(.note) { color: rgba(255,255,255,.5); }
  .foot-sub :global(input) { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.25); color: #fff; }
  .foot-sub :global(input::placeholder) { color: rgba(255,255,255,.5); }
  .foot-base {
    margin-top: 3rem; padding-block: 1.4rem;
    border-top: 1px solid rgba(255,255,255,.15);
  }
  .foot-base p { margin: 0; font-size: .82rem; color: rgba(255,255,255,.6); }
</style>
